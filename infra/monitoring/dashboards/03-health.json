        { "title": "PostgreSQL и Redis", "width": 6, "expr": ["pixel_battle_dependency_up"], "alias": ["{{dependency}}"] },
        { "title": "Время HTTP-проверки", "width": 6, "unit": "s", "expr": ["probe_duration_seconds{job=\"http\"}"], "alias": ["{{instance}}"] }
      ]
    }
  ]
