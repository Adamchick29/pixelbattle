# Local: copy to .env, then docker compose up --build -d --wait
# Use scripts/configure-local.ps1 or scripts/configure-local.sh to generate secrets.
APP_PORT=8787
APP_ORIGIN=http://localhost:8787
SESSION_COOKIE_SECURE=false
POSTGRES_PASSWORD=replace-with-long-random-password
REDIS_PASSWORD=replace-with-another-random-password
MONITORING_USER=monitor
# Bcrypt hash generated by: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# Keep the hash in SINGLE QUOTES so Docker Compose does not interpolate its $ signs.
MONITORING_PASSWORD_HASH='replace-with-bcrypt-hash'
IMAGE_PREFIX=pixel-battle
IMAGE_TAG=local
